@page
@model BoxeGymManager.Pages.Payments.CreateModel
@{
    ViewData["Title"] = "Lançar Mensalidade / Pagamento";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 text-white mb-0">LANÇAR MENSALIDADE / TAXA</h1>
        <p class="text-secondary mb-0">Registro financeiro com emissão automática de recibo.</p>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="boxing-card p-4">
            <form method="post">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Payment.StudentId" class="form-label text-light small fw-bold">Atleta / Aluno</label>
                        <select asp-for="Payment.StudentId" class="form-select form-select-lg" asp-items="Model.StudentsList" required>
                            <option value="">-- Selecione o Aluno --</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Payment.ReceiptCode" class="form-label text-light small fw-bold">Código do Recibo</label>
                        <input asp-for="Payment.ReceiptCode" class="form-control text-warning fw-bold" required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Payment.Amount" class="form-label text-light small fw-bold">Valor (R$)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-black text-secondary border-secondary">R$</span>
                            <input asp-for="Payment.Amount" type="number" step="0.01" class="form-control text-success fw-bold fs-5" required />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Payment.ReferenceMonthYear" class="form-label text-light small fw-bold">Mês de Referência</label>
                        <input asp-for="Payment.ReferenceMonthYear" class="form-control" placeholder="MM/AAAA" required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Payment.DueDate" class="form-label text-light small fw-bold">Data de Vencimento</label>
                        <input asp-for="Payment.DueDate" type="date" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Payment.Status" class="form-label text-light small fw-bold">Status do Pagamento</label>
                        <select asp-for="Payment.Status" class="form-select" asp-items="Html.GetEnumSelectList<BoxeGymManager.Models.PaymentStatus>()"></select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Payment.Method" class="form-label text-light small fw-bold">Forma de Pagamento</label>
                        <select asp-for="Payment.Method" class="form-select" asp-items="Html.GetEnumSelectList<BoxeGymManager.Models.PaymentMethod>()"></select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Payment.Notes" class="form-label text-light small fw-bold">Observações / Detalhes</label>
                        <textarea asp-for="Payment.Notes" class="form-control" rows="2" placeholder="Ex: Mensalidade Boxe Fit paga via Pix"></textarea>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-success btn-lg fw-bold py-3">
                        <i class="bi bi-check-circle me-2"></i> Confirmar & Emitir Recibo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
