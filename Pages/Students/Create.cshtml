@page
@model BoxeGymManager.Pages.Students.CreateModel
@{
    ViewData["Title"] = "Novo Aluno / Atleta";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 text-white mb-0">MATRÍCULA DE NOVO ATLETA</h1>
        <p class="text-secondary mb-0">Cadastre os dados pessoais, modalidade, ficha esportiva e plano de acesso.</p>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Voltar à Lista
    </a>
</div>

<form method="post">
    <div class="row g-4">
        <!-- 1) MODALIDADE (primeiro campo do formulário, obrigatório) -->
        <div class="col-12">
            <div class="boxing-card p-4 border border-danger border-opacity-50">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h3 class="h5 text-white mb-0">
                        <i class="bi bi-trophy-fill text-danger me-2"></i> 1. Modalidade Esportiva
                    </h3>
                    <span class="badge bg-danger">Obrigatório</span>
                </div>
                <div class="row g-3 align-items-center">
                    <div class="col-md-6">
                        <label asp-for="Student.Modality" class="form-label text-light small fw-bold">Modalidade</label>
                        <select asp-for="Student.Modality" class="form-select form-select-lg fw-bold bg-dark text-white border-danger" asp-items="Html.GetEnumSelectList<BoxeGymManager.Models.SportModality>()" required>
                        </select>
                        <div class="form-text text-secondary">Boxe, Jiu-Jitsu ou Muay Thai (expansível para novas modalidades).</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Student.RegistrationCode" class="form-label text-light small fw-bold">Matrícula Gerada</label>
                        <input asp-for="Student.RegistrationCode" class="form-control text-danger fw-bold form-control-lg" required />
                    </div>
                </div>
            </div>
        </div>

        <!-- 2) DADOS PESSOAIS & CONTATO DE EMERGÊNCIA -->
        <div class="col-lg-6 d-flex flex-column gap-4">
            <!-- Dados Pessoais (ordem: Nome, data de nascimento, CPF, CNH, filiação, endereço, e-mail, telefone) -->
            <div class="boxing-card p-4">
                <h3 class="h5 text-white mb-3">
                    <i class="bi bi-person-lines-fill text-secondary me-2"></i> 2. Dados Pessoais
                </h3>

                <div class="row g-3">
                    <!-- Nome -->
                    <div class="col-12">
                        <label asp-for="Student.FullName" class="form-label text-light small fw-bold">Nome Completo</label>
                        <input asp-for="Student.FullName" class="form-control" placeholder="Ex: Rodrigo 'Navalha' Silva" required />
                        <span asp-validation-for="Student.FullName" class="text-danger small"></span>
                    </div>

                    <!-- Data de Nascimento -->
                    <div class="col-md-6">
                        <label asp-for="Student.BirthDate" class="form-label text-light small fw-bold">Data de Nascimento</label>
                        <input asp-for="Student.BirthDate" id="birthDateInput" type="date" class="form-control" required />
                        <span asp-validation-for="Student.BirthDate" class="text-danger small"></span>
                    </div>

                    <!-- CPF -->
                    <div class="col-md-6">
                        <label asp-for="Student.CPF" class="form-label text-light small fw-bold">CPF</label>
                        <input asp-for="Student.CPF" class="form-control" placeholder="000.000.000-00" />
                        <span asp-validation-for="Student.CPF" class="text-danger small"></span>
                    </div>

                    <!-- CNH (opcional, 11 dígitos) -->
                    <div class="col-12">
                        <label asp-for="Student.CNH" class="form-label text-light small fw-bold">CNH <span class="text-secondary fw-normal">(opcional)</span></label>
                        <input asp-for="Student.CNH" class="form-control" placeholder="Ex: 12345678901 (11 dígitos numéricos)" maxlength="14" />
                        <span asp-validation-for="Student.CNH" class="text-danger small"></span>
                    </div>

                    <!-- Filiação (exibido e exigido apenas para menores de 18 anos) -->
                    <div class="col-12" id="guardianSection" style="display: none;">
                        <div class="p-3 bg-dark rounded border border-warning border-opacity-75">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-warning small">
                                    <i class="bi bi-shield-exclamation me-1"></i> Filiação / Responsável Legal (Aluno Menor de Idade)
                                </span>
                                <span class="badge bg-warning text-dark">Obrigatório para &lt; 18 anos</span>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label asp-for="Student.GuardianName" class="form-label text-light small fw-bold">Nome do Pai, Mãe ou Responsável</label>
                                    <input asp-for="Student.GuardianName" id="guardianNameInput" class="form-control" placeholder="Nome completo do responsável" />
                                    <span asp-validation-for="Student.GuardianName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Student.GuardianPhone" class="form-label text-light small fw-bold">Telefone do Responsável</label>
                                    <input asp-for="Student.GuardianPhone" id="guardianPhoneInput" class="form-control" placeholder="(11) 98888-8888" />
                                    <span asp-validation-for="Student.GuardianPhone" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Student.GuardianAddress" class="form-label text-light small fw-bold">Endereço do Responsável <span class="text-secondary fw-normal">(opcional)</span></label>
                                    <input asp-for="Student.GuardianAddress" class="form-control" placeholder="Rua, número, bairro (se diferente do aluno)" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Endereço -->
                    <div class="col-12">
                        <label asp-for="Student.Address" class="form-label text-light small fw-bold">Endereço Completo</label>
                        <input asp-for="Student.Address" class="form-control" placeholder="Rua, número, bairro, cidade" />
                    </div>

                    <!-- E-mail -->
                    <div class="col-md-6">
                        <label asp-for="Student.Email" class="form-label text-light small fw-bold">E-mail</label>
                        <input asp-for="Student.Email" type="email" class="form-control" placeholder="atleta@email.com" />
                    </div>

                    <!-- Telefone -->
                    <div class="col-md-6">
                        <label asp-for="Student.Phone" class="form-label text-light small fw-bold">Telefone / WhatsApp</label>
                        <input asp-for="Student.Phone" class="form-control" placeholder="(11) 99999-9999" required />
                    </div>
                </div>
            </div>

            <!-- Contato de Emergência -->
            <div class="boxing-card p-4 border border-secondary border-opacity-50 flex-grow-1">
                <h3 class="h5 text-white mb-3">
                    <i class="bi bi-telephone-plus text-secondary me-2"></i> Contato de Emergência
                </h3>
                <p class="text-secondary small mb-3">Pessoa autorizada a ser contatada em caso de urgência durante treinos ou sparrings.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Student.EmergencyContactName" class="form-label text-light small fw-bold">Nome do Contato</label>
                        <input asp-for="Student.EmergencyContactName" class="form-control" placeholder="Ex: Maria Silva (Mãe)" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Student.EmergencyContactPhone" class="form-label text-light small fw-bold">Telefone de Emergência</label>
                        <input asp-for="Student.EmergencyContactPhone" class="form-control" placeholder="(11) 98888-8888" />
                    </div>
                </div>
            </div>
        </div>

        <!-- 3) FICHA TÉCNICA & PLANO DE ACESSO -->
        <div class="col-lg-6 d-flex flex-column gap-4">
            <!-- Ficha Técnica -->
            <div class="boxing-card p-4">
                <h3 class="h5 text-white mb-3">
                    <i class="bi bi-shield-shaded text-secondary me-2"></i> 3. Ficha Técnica
                </h3>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Student.WeightKg" class="form-label text-light small fw-bold">Peso Atual (Kg)</label>
                        <input asp-for="Student.WeightKg" type="number" step="0.1" class="form-control" placeholder="Ex: 72.5" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Student.WeightCategory" class="form-label text-light small fw-bold">Categoria de Peso</label>
                        <input asp-for="Student.WeightCategory" class="form-control" placeholder="Ex: Peso Médio (ou automático)" />
                    </div>

                    <!-- Novos campos: Altura e Envergadura -->
                    <div class="col-md-6">
                        <label asp-for="Student.HeightCm" class="form-label text-light small fw-bold">Altura (cm) <span class="text-secondary fw-normal">(opcional)</span></label>
                        <input asp-for="Student.HeightCm" type="number" step="1" class="form-control" placeholder="Ex: 178" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Student.ReachCm" class="form-label text-light small fw-bold">Envergadura (cm) <span class="text-secondary fw-normal">(opcional)</span></label>
                        <input asp-for="Student.ReachCm" type="number" step="1" class="form-control" placeholder="Ex: 182" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Student.ExperienceLevel" class="form-label text-light small fw-bold">Nível Esportivo</label>
                        <select asp-for="Student.ExperienceLevel" class="form-select" asp-items="Html.GetEnumSelectList<BoxeGymManager.Models.BoxingLevel>()"></select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Student.Stance" class="form-label text-light small fw-bold">Base de Luta (Stance)</label>
                        <select asp-for="Student.Stance" class="form-select">
                            <option value="Destro (Orthodox)">Destro (Orthodox)</option>
                            <option value="Canhoto (Southpaw)">Canhoto (Southpaw)</option>
                            <option value="Ambidestro (Switch)">Ambidestro (Switch)</option>
                        </select>
                    </div>

                    <!-- Novo campo: Informações da modalidade (textarea livre) -->
                    <div class="col-12">
                        <label asp-for="Student.ModalityNotes" class="form-label text-light small fw-bold">Informações da Modalidade <span class="text-secondary fw-normal">(opcional)</span></label>
                        <textarea asp-for="Student.ModalityNotes" class="form-control" rows="2" placeholder="Anotações gerais da modalidade (graduação, tempo de treino, estilo, etc.)"></textarea>
                    </div>

                    <div class="col-12">
                        <label asp-for="Student.MedicalNotes" class="form-label text-light small fw-bold">Observações Médicas / Restrições Físicas</label>
                        <textarea asp-for="Student.MedicalNotes" class="form-control" rows="2" placeholder="Cirurgias prévias, problemas articulares, hipertensão, etc."></textarea>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mt-1">
                            <input class="form-check-input" type="checkbox" asp-for="Student.HasMedicalCertificate" checked />
                            <label class="form-check-label text-light" asp-for="Student.HasMedicalCertificate">
                                Atestado médico de aptidão física regularizado
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Associação de Plano -->
            <div class="boxing-card p-4 flex-grow-1">
                <h3 class="h5 text-white mb-3">
                    <i class="bi bi-card-checklist text-secondary me-2"></i> 4. Plano & Mensalidade
                </h3>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Student.PlanId" class="form-label text-light small fw-bold">Plano de Treino Escolhido</label>
                        <select asp-for="Student.PlanId" id="planSelect" class="form-select form-select-lg" asp-items="Model.PlansList">
                            <option value="">-- Sem plano por enquanto --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Student.PlanStartDate" class="form-label text-light small fw-bold">Data de Início da Matrícula</label>
                        <input asp-for="Student.PlanStartDate" id="planStartDate" type="date" class="form-control" />
                    </div>

                    <!-- 1) Dia de Vencimento Fixo (Obrigatório: dia 10 ou 25) -->
                    <div class="col-md-6" id="groupDiaVencimento">
                        <label class="form-label text-light small fw-bold">
                            <i class="bi bi-calendar-event text-warning me-1"></i> Dia de Vencimento <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-2">
                            @foreach (var dia in Model.DiasVencimentoPermitidos)
                            {
                                <div class="form-check form-check-inline bg-black p-2 px-3 rounded border border-secondary flex-fill text-center">
                                    <input class="form-check-input due-day-radio" type="radio" asp-for="Student.DiaVencimento" id="venc_@dia" value="@dia" />
                                    <label class="form-check-label text-white fw-bold cursor-pointer" for="venc_@dia">
                                        Todo dia @dia
                                    </label>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="Student.DiaVencimento" class="text-danger small"></span>
                    </div>

                    <!-- Resumo Proporcional do 1º Pagamento -->
                    <div class="col-12" id="boxResumoProporcional" style="display: none;">
                        <div class="p-3 bg-dark rounded border border-warning border-opacity-75 shadow-sm">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="text-warning fw-bold small">
                                    <i class="bi bi-calculator me-1"></i> Resumo do 1º Pagamento Proporcional
                                </span>
                                <span class="badge bg-warning text-dark fw-bold" id="badgeAjuste">Ajuste</span>
                            </div>
                            <div class="row g-2 small">
                                <div class="col-6 col-md-3">
                                    <span class="text-secondary d-block">Mensalidade:</span>
                                    <span class="text-white fw-bold" id="resumoValorPlano">R$ 0,00</span>
                                </div>
                                <div class="col-6 col-md-3">
                                    <span class="text-secondary d-block">Ajuste Proporcional:</span>
                                    <span class="fw-bold" id="resumoAjuste">0 dias</span>
                                </div>
                                <div class="col-6 col-md-3">
                                    <span class="text-secondary d-block">1º Vencimento:</span>
                                    <span class="text-warning fw-bold" id="resumoPrimeiroVencimento">--/--/----</span>
                                </div>
                                <div class="col-6 col-md-3">
                                    <span class="text-secondary d-block">1º Pagamento:</span>
                                    <span class="text-success fw-bold fs-6" id="resumoPrimeiroValor">R$ 0,00</span>
                                </div>
                            </div>
                            <div class="mt-2 text-secondary" style="font-size: 0.78rem;" id="resumoExplicacao">
                                Cálculo baseado em mês comercial de 30 dias. A validade inicial do plano cobrirá até a data do 1º vencimento.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 d-flex align-items-center">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="Student.IsActive" checked />
                            <label class="form-check-label text-light fw-bold" asp-for="Student.IsActive">
                                Matrícula Ativa
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Rodapé de Ações Unificado e Alinhado -->
        <div class="col-12">
            <div class="boxing-card p-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="text-secondary small">
                    <i class="bi bi-shield-check me-1 text-secondary"></i> O código de matrícula, modalidade e planos poderão ser reajustados a qualquer momento na edição do atleta.
                </div>
                <div class="d-flex gap-2 w-100 w-md-auto justify-content-end">
                    <a asp-page="./Index" class="btn btn-outline-secondary px-4 fw-semibold">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-danger btn-lg fw-bold text-white px-5 shadow">
                        <i class="bi bi-check2-circle me-2"></i> Concluir Matrícula
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function updateGuardianVisibility() {
            const birthInput = document.getElementById('birthDateInput');
            const guardianSec = document.getElementById('guardianSection');
            const guardianName = document.getElementById('guardianNameInput');
            const guardianPhone = document.getElementById('guardianPhoneInput');

            if (!birthInput || !guardianSec) return;

            if (!birthInput.value) {
                guardianSec.style.display = 'none';
                if (guardianName) guardianName.removeAttribute('required');
                if (guardianPhone) guardianPhone.removeAttribute('required');
                return;
            }

            const parts = birthInput.value.split('-');
            if (parts.length === 3) {
                const birthDate = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
                const today = new Date();
                let age = today.getFullYear() - birthDate.getFullYear();
                const m = today.getMonth() - birthDate.getMonth();
                if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }

                if (age < 18) {
                    guardianSec.style.display = 'block';
                    if (guardianName) guardianName.setAttribute('required', 'required');
                    if (guardianPhone) guardianPhone.setAttribute('required', 'required');
                } else {
                    guardianSec.style.display = 'none';
                    if (guardianName) guardianName.removeAttribute('required');
                    if (guardianPhone) guardianPhone.removeAttribute('required');
                }
            }
        }

        document.getElementById('birthDateInput')?.addEventListener('change', updateGuardianVisibility);
        document.getElementById('birthDateInput')?.addEventListener('input', updateGuardianVisibility);
        document.addEventListener('DOMContentLoaded', updateGuardianVisibility);

        // Cálculo Proporcional no Servidor
        async function calcularResumoProporcional() {
            const planSelect = document.getElementById('planSelect');
            const planStartDate = document.getElementById('planStartDate');
            const selectedDueRadio = document.querySelector('input.due-day-radio:checked');
            const box = document.getElementById('boxResumoProporcional');

            if (!planSelect || !box) return;

            const planId = planSelect.value;
            const diaVencimento = selectedDueRadio ? selectedDueRadio.value : '';
            const dataMatricula = planStartDate ? planStartDate.value : '';

            if (!planId || !diaVencimento) {
                box.style.display = 'none';
                return;
            }

            try {
                const response = await fetch(`?handler=CalcularProporcional&planId=${encodeURIComponent(planId)}&diaVencimento=${encodeURIComponent(diaVencimento)}&dataMatricula=${encodeURIComponent(dataMatricula)}`);
                if (!response.ok) {
                    box.style.display = 'none';
                    return;
                }

                const data = await response.json();
                box.style.display = 'block';

                const formatter = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

                document.getElementById('resumoValorPlano').innerText = formatter.format(data.valorMensalidade);
                document.getElementById('resumoPrimeiroVencimento').innerText = data.primeiroVencimento;
                document.getElementById('resumoPrimeiroValor').innerText = formatter.format(data.valorPrimeiroPagamento);

                const elAjuste = document.getElementById('resumoAjuste');
                const badge = document.getElementById('badgeAjuste');

                if (data.diferencaDias < 0) {
                    elAjuste.className = 'text-success fw-bold';
                    elAjuste.innerText = `${data.diferencaDias} dias (${formatter.format(data.valorAjuste)})`;
                    badge.className = 'badge bg-success text-white fw-bold';
                    badge.innerText = `Desconto de ${formatter.format(Math.abs(data.valorAjuste))}`;
                } else if (data.diferencaDias > 0) {
                    elAjuste.className = 'text-warning fw-bold';
                    elAjuste.innerText = `+${data.diferencaDias} dias (+${formatter.format(data.valorAjuste)})`;
                    badge.className = 'badge bg-warning text-dark fw-bold';
                    badge.innerText = `Acréscimo de ${formatter.format(data.valorAjuste)}`;
                } else {
                    elAjuste.className = 'text-white fw-bold';
                    elAjuste.innerText = '0 dias (Sem ajuste)';
                    badge.className = 'badge bg-secondary text-white fw-bold';
                    badge.innerText = 'Sem ajuste';
                }
            } catch (err) {
                console.error('Erro ao calcular proporcional:', err);
                box.style.display = 'none';
            }
        }

        document.getElementById('planSelect')?.addEventListener('change', calcularResumoProporcional);
        document.getElementById('planStartDate')?.addEventListener('change', calcularResumoProporcional);
        document.querySelectorAll('input.due-day-radio').forEach(r => r.addEventListener('change', calcularResumoProporcional));
        document.addEventListener('DOMContentLoaded', calcularResumoProporcional);
    </script>
}
