@page
@model IndexModel
@{
    ViewData["Title"] = "Painel da Academia";
}

<!-- Cabeçalho do Dashboard -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="text-white mb-0 display-6">PAINEL OPERACIONAL DA ACADEMIA</h1>
        <p class="text-light opacity-75 mb-0">Gestão de atletas, pagamentos e controle de acesso ao ringue.</p>
    </div>
    <div>
        <a asp-page="/Students/Create" class="btn btn-danger fw-bold px-3 py-2 shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Matricular Atleta
        </a>
    </div>
</div>

<!-- Feedback de Check-In Rápido (Se houver) -->
@if (!string.IsNullOrEmpty(Model.QuickCheckInFeedback))
{
    <div class="alert alert-@Model.QuickCheckInStatusClass alert-dismissible fade show border-2 shadow-lg mb-4" role="alert">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-bell-fill fs-4 me-3"></i>
                <div>
                    <strong>Aviso de Portaria:</strong> @Model.QuickCheckInFeedback
                </div>
            </div>
            @if (Model.BlockedStudentId.HasValue)
            {
                <form method="post" asp-page-handler="OverrideCheckIn" class="m-0">
                    <input type="hidden" name="studentId" value="@Model.BlockedStudentId.Value" />
                    <button type="submit" class="btn btn-warning text-dark fw-bold px-3 shadow-sm">
                        <i class="bi bi-unlock-fill me-1"></i> Liberar Entrada Mesmo Assim
                    </button>
                </form>
            }
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Linha de Métricas Principais -->
<div class="row g-3 mb-4">
    <!-- Atletas Ativos -->
    <div class="col-sm-6 col-xl-3">
        <div class="boxing-card boxing-card-accent-neutral p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-light text-uppercase fw-bold small">Atletas Ativos</span>
                <span class="badge bg-secondary bg-opacity-25 text-light p-2 rounded-circle">
                    <i class="bi bi-people-fill fs-5"></i>
                </span>
            </div>
            <div class="stat-number text-white">@Model.TotalActiveStudents</div>
            <div class="small text-secondary">Matrículas ativas no sistema</div>
        </div>
    </div>

    <!-- No Ringue / Academia Agora -->
    <div class="col-sm-6 col-xl-3">
        <div class="boxing-card boxing-card-accent-neutral p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-light text-uppercase fw-bold small">Treinando Agora</span>
                <span class="badge bg-secondary bg-opacity-25 text-light p-2 rounded-circle">
                    <i class="bi bi-activity fs-5"></i>
                </span>
            </div>
            <div class="stat-number text-white">@Model.CurrentlyInGym</div>
            <div class="small text-secondary">Atletas dentro da academia</div>
        </div>
    </div>

    <!-- Check-ins Hoje -->
    <div class="col-sm-6 col-xl-3">
        <div class="boxing-card boxing-card-accent-neutral p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-light text-uppercase fw-bold small">Frequência do Dia</span>
                <span class="badge bg-secondary bg-opacity-25 text-light p-2 rounded-circle">
                    <i class="bi bi-check2-circle fs-5"></i>
                </span>
            </div>
            <div class="stat-number text-white">@Model.CheckInsToday</div>
            <div class="small text-secondary">Entradas registradas hoje</div>
        </div>
    </div>

    <!-- Faturamento do Mês -->
    <div class="col-sm-6 col-xl-3">
        <div class="boxing-card boxing-card-accent-neutral p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-light text-uppercase fw-bold small">Faturamento (Mês)</span>
                <span class="badge bg-secondary bg-opacity-25 text-light p-2 rounded-circle">
                    <i class="bi bi-cash-stack fs-5"></i>
                </span>
            </div>
            <div class="stat-number text-white">@Model.MonthlyRevenue.ToString("C")</div>
            <div class="small">
                @if (Model.OverduePaymentsCount > 0)
                {
                    <span class="text-danger fw-semibold"><i class="bi bi-exclamation-triangle"></i> @(Model.OverduePaymentsCount == 1 ? "1 pendente/atrasado" : $"{Model.OverduePaymentsCount} pendentes/atrasados")</span>
                }
                else
                {
                    <span class="text-success"><i class="bi bi-check-all"></i> Mensalidades em dia</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Linha 1: Operação e Acesso Imediato Integrado -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="boxing-card p-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
                <div>
                    <h3 class="h5 mb-1 text-white">
                        <i class="bi bi-door-open-fill text-secondary me-2"></i> Portaria & Últimas Entradas e Saídas
                    </h3>
                    <p class="small text-secondary mb-0">Valide a entrada/saída de atletas e acompanhe os registros em tempo real.</p>
                </div>
                <div>
                    <a asp-page="/CheckIn/Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-journal-text me-1"></i> Histórico Completo
                    </a>
                </div>
            </div>

            <!-- Caixa de Validação Rápida Integrada -->
            <div class="portaria-integrated-bar p-3 mb-4">
                <form method="post" asp-page-handler="QuickCheckIn" class="row g-2 align-items-center">
                    <div class="col-md-5 col-lg-4">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 px-2.5 py-1.5 fw-bold text-uppercase">
                                <i class="bi bi-qr-code-scan me-1"></i> Portaria Rápida
                            </span>
                            <span class="text-secondary small">
                                Digite matrícula (<strong class="text-white">BX-1001</strong>) ou CPF:
                            </span>
                        </div>
                    </div>
                    <div class="col-md-7 col-lg-8">
                        <div class="input-group input-group-lg shadow-sm">
                            <span class="input-group-text portaria-icon">
                                <i class="bi bi-person-badge-fill"></i>
                            </span>
                            <input type="text" asp-for="QuickCode" class="form-control portaria-input" placeholder="Digite a matrícula ou CPF do atleta..." required autocomplete="off" />
                            <button class="btn btn-danger fw-bold px-4 text-white" type="submit">
                                <i class="bi bi-arrow-right-circle me-1"></i> Registrar
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Tabela de Últimas Entradas e Saídas -->
            @if (Model.RecentAttendances.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark-custom w-100 mb-0">
                        <thead>
                            <tr>
                                <th>Atleta</th>
                                <th>Entrada</th>
                                <th>Saída</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentAttendances)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-white">@item.Student?.FullName</div>
                                        <div class="small text-secondary">
                                            <span class="text-meta-label">Matrícula:</span> <span class="badge bg-dark border border-secondary text-subtle-light">@item.Student?.RegistrationCode</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-white fw-semibold">@item.EntryTime.ToString("HH:mm")</span>
                                        <div class="small text-secondary">@item.EntryTime.ToString("dd/MM")</div>
                                    </td>
                                    <td>
                                        @if (item.AccessStatus == AccessStatus.BloqueadoInativo || item.AccessStatus == AccessStatus.BloqueadoInadimplente)
                                        {
                                            <span class="badge bg-secondary text-light"><i class="bi bi-slash-circle me-1"></i> Entrada Barrada</span>
                                        }
                                        else if (item.ExitTime.HasValue)
                                        {
                                            <span class="text-subtle-light fw-semibold">@item.ExitTime.Value.ToString("HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-75"><i class="bi bi-broadcast"></i> No Treino</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.AccessStatus == AccessStatus.Autorizado)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Liberado</span>
                                        }
                                        else if (item.AccessStatus == AccessStatus.BloqueadoInadimplente)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-octagon"></i> Inadimplente</span>
                                        }
                                        else if (item.AccessStatus == AccessStatus.AlertaVencimento)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Pendência</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-octagon"></i> Bloqueado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-secondary">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
                    Nenhum registro de acesso recente.
                </div>
            }
        </div>
    </div>
</div>

<!-- Linha 2: Programação & Financeiro -->
<div class="row g-4">
    <!-- Grade de Aulas de Hoje -->
    <div class="col-lg-6">
        <div class="boxing-card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="h5 mb-0 text-white">
                    <i class="bi bi-clock-history text-secondary me-1"></i> Aulas de Hoje (@DateTime.Today.ToString("dddd, dd/MM"))
                </h3>
                <a asp-page="/Schedule/Index" class="btn btn-sm btn-outline-secondary">Ver Grade</a>
            </div>

            @if (Model.TodayClasses.Any())
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var c in Model.TodayClasses)
                    {
                        <div class="schedule-slot d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold text-white">@c.Title</div>
                                <div class="small text-secondary">
                                    <i class="bi bi-person-badge"></i> @c.CoachName &bull; <i class="bi bi-geo-alt"></i> @c.RingOrRoom
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-dark border border-secondary text-subtle-light fs-6">@c.StartTime.ToString(@"hh\:mm") - @c.EndTime.ToString(@"hh\:mm")</span>
                                <div class="small text-secondary mt-1"><span class="text-meta-label">Capacidade:</span> @c.MaxCapacity</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-secondary">
                    <i class="bi bi-calendar-x fs-1 d-block mb-2 text-muted"></i>
                    Nenhuma aula programada para hoje. Treino livre de saco e ringue liberado!
                </div>
            }
        </div>
    </div>

    <!-- Mensalidades a Vencer / Atrasadas -->
    <div class="col-lg-6">
        <div class="boxing-card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="h5 mb-0 text-white">
                    <i class="bi bi-cash-stack text-secondary me-1"></i> Mensalidades Pendentes
                </h3>
                <a asp-page="/Payments/Index" class="btn btn-sm btn-outline-secondary">Ver Todas</a>
            </div>

            @if (Model.PendingPayments.Any())
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var p in Model.PendingPayments)
                    {
                        var isOverdue = p.Status == PaymentStatus.Atrasado || (p.Status == PaymentStatus.Pendente && p.DueDate < DateTime.Today);
                        <div class="payment-card-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold text-white fs-6">@p.Student?.FullName</div>
                                <div class="text-secondary small">
                                    <span class="text-meta-label">Vencimento:</span> <strong class="text-white">@p.DueDate.ToString("dd/MM/yyyy")</strong>
                                    &bull; <span class="text-subtle-light">@p.Student?.RegistrationCode</span>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-success fs-6">@p.Amount.ToString("C")</div>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger text-white"><i class="bi bi-exclamation-triangle-fill me-1"></i> Atrasado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-light"><i class="bi bi-clock me-1"></i> A Vencer</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-secondary small">
                    <i class="bi bi-check-circle fs-2 d-block mb-2 text-success"></i>
                    Nenhuma mensalidade pendente no momento.
                </div>
            }
        </div>
    </div>
</div>
