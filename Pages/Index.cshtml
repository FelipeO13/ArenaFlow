@page
@model IndexModel
@{
    ViewData["Title"] = "Painel da Academia";
}

<!-- Cabeçalho do Dashboard -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="text-white mb-0 display-6">PAINEL OPERACIONAL DA ACADEMIA</h1>
        <p class="text-light opacity-75 mb-0">Gestão de atletas, pagamentos e controle de acesso ao ringue.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/CheckIn/Index" class="btn btn-outline-light fw-bold px-3 py-2">
            <i class="bi bi-door-open me-1 text-danger"></i> Controle de Entrada/Saída
        </a>
        <a asp-page="/Students/Create" class="btn btn-danger fw-bold px-3 py-2">
            <i class="bi bi-person-plus-fill me-1"></i> Matricular Atleta
        </a>
    </div>
</div>

<!-- Feedback de Check-In Rápido (Se houver) -->
@if (!string.IsNullOrEmpty(Model.QuickCheckInFeedback))
{
    <div class="alert alert-@Model.QuickCheckInStatusClass alert-dismissible fade show border-2 shadow-lg mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-bell-fill fs-4 me-3"></i>
            <div>
                <strong>Aviso de Portaria:</strong> @Model.QuickCheckInFeedback
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Linha de Métricas Principais -->
<div class="row g-3 mb-4">
    <!-- Atletas Ativos -->
    <div class="col-sm-6 col-xl-3">
        <div class="boxing-card boxing-card-accent-red p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-light text-uppercase fw-bold small">Atletas Ativos</span>
                <span class="badge bg-danger bg-opacity-25 text-danger p-2 rounded-circle">
                    <i class="bi bi-people-fill fs-5"></i>
                </span>
            </div>
            <div class="stat-number text-white">@Model.TotalActiveStudents</div>
            <div class="small text-secondary">Matrículas ativas no sistema</div>
        </div>
    </div>

    <!-- No Ringue / Academia Agora -->
    <div class="col-sm-6 col-xl-3">
        <div class="boxing-card boxing-card-accent-red p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-light text-uppercase fw-bold small">Treinando Agora</span>
                <span class="badge bg-danger bg-opacity-25 text-danger p-2 rounded-circle">
                    <i class="bi bi-activity fs-5"></i>
                </span>
            </div>
            <div class="stat-number text-white">@Model.CurrentlyInGym</div>
            <div class="small text-secondary">Atletas dentro da academia</div>
        </div>
    </div>

    <!-- Check-ins Hoje -->
    <div class="col-sm-6 col-xl-3">
        <div class="boxing-card boxing-card-accent-white p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-light text-uppercase fw-bold small">Frequência do Dia</span>
                <span class="badge bg-light bg-opacity-10 text-white p-2 rounded-circle">
                    <i class="bi bi-check2-circle fs-5"></i>
                </span>
            </div>
            <div class="stat-number text-white">@Model.CheckInsToday</div>
            <div class="small text-secondary">Entradas registradas hoje</div>
        </div>
    </div>

    <!-- Faturamento do Mês -->
    <div class="col-sm-6 col-xl-3">
        <div class="boxing-card boxing-card-accent-green p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-light text-uppercase fw-bold small">Faturamento (Mês)</span>
                <span class="badge bg-success bg-opacity-25 text-success p-2 rounded-circle">
                    <i class="bi bi-cash-stack fs-5"></i>
                </span>
            </div>
            <div class="stat-number text-white">@Model.MonthlyRevenue.ToString("C")</div>
            <div class="small text-secondary">
                @if (Model.OverduePaymentsCount > 0)
                {
                    <span class="text-danger fw-semibold"><i class="bi bi-exclamation-triangle"></i> @Model.OverduePaymentsCount pendentes/atrasados</span>
                }
                else
                {
                    <span class="text-success"><i class="bi bi-check-all"></i> Mensalidades em dia</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Coluna Esquerda: Terminal Rápido de Recepção & Grade de Hoje -->
    <div class="col-lg-5">
        <!-- Widget: Check-in Rápido -->
        <div class="boxing-card portaria-card p-4 mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="h5 mb-0 text-white">
                    <i class="bi bi-shield-check text-danger me-2"></i> Portaria Rápida (Entrada/Saída)
                </h3>
                <span class="badge bg-danger text-white fw-bold">Recepção</span>
            </div>
            <p class="small text-light mb-3 opacity-75">
                Digite a <strong class="text-white">matrícula</strong> (ex: <code class="text-white bg-black px-1 py-0.5 rounded border border-secondary">BX-1001</code>) ou <strong class="text-white">CPF</strong> para validar entrada ou saída imediata.
            </p>
            <form method="post" asp-page-handler="QuickCheckIn">
                <div class="input-group input-group-lg mb-2 shadow-sm">
                    <span class="input-group-text portaria-icon">
                        <i class="bi bi-qr-code-scan"></i>
                    </span>
                    <input type="text" asp-for="QuickCode" class="form-control portaria-input" placeholder="Matrícula ou CPF..." required autocomplete="off" />
                    <button class="btn btn-danger fw-bold px-4 text-white" type="submit">
                        <i class="bi bi-arrow-right-circle me-1"></i> Registrar
                    </button>
                </div>
            </form>
        </div>

        <!-- Grade de Aulas de Hoje -->
        <div class="boxing-card p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="h5 mb-0 text-white">
                    <i class="bi bi-clock-history text-danger me-1"></i> Aulas de Hoje (@DateTime.Today.ToString("dddd, dd/MM"))
                </h3>
                <a asp-page="/Schedule/Index" class="btn btn-sm btn-outline-secondary">Ver Grade</a>
            </div>

            @if (Model.TodayClasses.Any())
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var c in Model.TodayClasses)
                    {
                        <div class="schedule-slot d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold text-white">@c.Title</div>
                                <div class="small text-secondary">
                                    <i class="bi bi-person-badge"></i> @c.CoachName &bull; <i class="bi bi-geo-alt"></i> @c.RingOrRoom
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-danger fs-6">@c.StartTime.ToString(@"hh\:mm") - @c.EndTime.ToString(@"hh\:mm")</span>
                                <div class="small text-muted mt-1">Capacidade: @c.MaxCapacity</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                    Nenhuma aula programada para hoje. Treino livre de saco e ringue liberado!
                </div>
            }
        </div>
    </div>

    <!-- Coluna Direita: Últimos Check-ins e Movimentação -->
    <div class="col-lg-7">
        <div class="boxing-card p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="h5 mb-0 text-white">
                    <i class="bi bi-door-open-fill text-primary me-1"></i> Últimas Entradas e Saídas
                </h3>
                <a asp-page="/CheckIn/Index" class="btn btn-sm btn-outline-danger">Histórico Completo</a>
            </div>

            @if (Model.RecentAttendances.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark-custom w-100">
                        <thead>
                            <tr>
                                <th>Atleta</th>
                                <th>Entrada</th>
                                <th>Saída</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.RecentAttendances)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-white">@item.Student?.FullName</div>
                                        <div class="small text-secondary">
                                            Matrícula: <span class="badge bg-secondary">@item.Student?.RegistrationCode</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-info fw-semibold">@item.EntryTime.ToString("HH:mm")</span>
                                        <div class="small text-muted">@item.EntryTime.ToString("dd/MM")</div>
                                    </td>
                                    <td>
                                        @if (item.ExitTime.HasValue)
                                        {
                                            <span class="text-muted fw-semibold">@item.ExitTime.Value.ToString("HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-75"><i class="bi bi-broadcast"></i> No Treino</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.AccessStatus == AccessStatus.Autorizado)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle"></i> Liberado</span>
                                        }
                                        else if (item.AccessStatus == AccessStatus.AlertaVencimento)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Pendência</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-octagon"></i> Bloqueado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    Nenhum registro de acesso recente.
                </div>
            }
        </div>
    </div>
</div>
