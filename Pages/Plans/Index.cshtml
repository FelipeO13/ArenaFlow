@page
@model BoxeGymManager.Pages.Plans.IndexModel
@{
    ViewData["Title"] = "Planos de Boxe";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="display-6 text-white mb-0">PLANOS & ASSINATURAS DE BOXE</h1>
        <p class="text-secondary mb-0">Configuração de modalidades, frequências semanais e valores de mensalidades.</p>
    </div>
    <div>
        <a asp-page="/Plans/Create" class="btn btn-danger fw-bold px-4 py-2">
            <i class="bi bi-plus-circle me-1"></i> Criar Novo Plano
        </a>
    </div>
</div>

<div class="row g-4">
    @foreach (var item in Model.Plans)
    {
        var plan = item.Plan;
        <div class="col-md-6 col-xl-3">
            <div class="boxing-card p-4 h-100 d-flex flex-column justify-content-between @(plan.IncludesSparring ? "boxing-card-accent-red" : "boxing-card-accent-gold")">
                <div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge @(plan.IsActive ? "bg-success" : "bg-secondary")">
                            @(plan.IsActive ? "Ativo" : "Inativo")
                        </span>
                        @if (plan.IncludesSparring)
                        {
                            <span class="badge bg-danger"><i class="bi bi-shield-shaded"></i> Sparring</span>
                        }
                    </div>

                    <h3 class="h4 text-white mb-2">@plan.Name</h3>
                    <p class="small text-secondary mb-3">@plan.Description</p>

                    <div class="my-3">
                        <span class="display-6 fw-bold text-warning">@plan.Price.ToString("C")</span>
                        <span class="text-muted small">/@plan.BillingCycle.ToString().ToLower()</span>
                    </div>

                    <ul class="list-unstyled small text-light d-flex flex-column gap-2 mb-4">
                        <li>
                            <i class="bi bi-calendar-check text-warning me-2"></i>
                            @(plan.DaysPerWeek == 0 ? "Acesso Livre Todos os Dias" : $"{plan.DaysPerWeek}x por semana")
                        </li>
                        <li>
                            <i class="bi bi-people text-info me-2"></i>
                            <strong>@item.StudentCount</strong> alunos matriculados
                        </li>
                    </ul>
                </div>

                <div class="d-flex gap-2 pt-3 border-top border-secondary border-opacity-25">
                    <a asp-page="/Plans/Edit" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-warning w-100 fw-semibold">
                        <i class="bi bi-pencil me-1"></i> Editar
                    </a>
                </div>
            </div>
        </div>
    }
</div>
