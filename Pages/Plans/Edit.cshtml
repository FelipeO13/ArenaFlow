@page "{id:int}"
@model BoxeGymManager.Pages.Plans.EditModel
@{
    ViewData["Title"] = $"Editar {Model.Plan.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 text-white mb-0">EDITAR PLANO DE BOXE</h1>
        <p class="text-secondary mb-0">Atualização de preço e regras do plano.</p>
    </div>
    <a asp-page="./Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Voltar
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="boxing-card p-4">
            <form method="post">
                <input type="hidden" asp-for="Plan.Id" />

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Plan.Name" class="form-label text-light small fw-bold">Nome do Plano</label>
                        <input asp-for="Plan.Name" class="form-control form-control-lg" required />
                    </div>

                    <div class="col-12">
                        <label asp-for="Plan.Description" class="form-label text-light small fw-bold">Descrição</label>
                        <textarea asp-for="Plan.Description" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Plan.Price" class="form-label text-light small fw-bold">Valor (R$)</label>
                        <input asp-for="Plan.Price" type="number" step="0.01" class="form-control text-warning fw-bold fs-5" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Plan.BillingCycle" class="form-label text-light small fw-bold">Periodicidade</label>
                        <select asp-for="Plan.BillingCycle" class="form-select" asp-items="Html.GetEnumSelectList<BoxeGymManager.Models.PlanBillingCycle>()"></select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Plan.DaysPerWeek" class="form-label text-light small fw-bold">Dias por Semana (0 = Livre)</label>
                        <input asp-for="Plan.DaysPerWeek" type="number" min="0" max="7" class="form-control" />
                    </div>

                    <div class="col-md-6 d-flex flex-column justify-content-end">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Plan.IncludesSparring" />
                            <label class="form-check-label text-light" asp-for="Plan.IncludesSparring">
                                Inclui Sparring
                            </label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Plan.IsActive" />
                            <label class="form-check-label text-light" asp-for="Plan.IsActive">
                                Plano Ativo
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-warning btn-lg fw-bold text-dark py-3">
                        <i class="bi bi-save me-2"></i> Salvar Alterações
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
