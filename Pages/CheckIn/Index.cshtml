@page
@model BoxeGymManager.Pages.CheckIn.IndexModel
@{
    ViewData["Title"] = "Terminal de Entrada e Saída";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 text-white mb-0">CONTROLE DE ACESSO & CATRACA</h1>
        <p class="text-secondary mb-0">Registro de presença dos atletas e liberação de entrada no ringue.</p>
    </div>
    <div class="text-end">
        <span class="badge bg-dark border border-secondary text-warning fs-6 px-3 py-2">
            <i class="bi bi-clock me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.AlertMessage))
{
    <div class="alert alert-@Model.AlertType alert-dismissible fade show border-2 shadow-lg mb-4" role="alert">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center">
                @if (Model.AlertType == "success")
                {
                    <i class="bi bi-check-circle-fill fs-3 text-success me-3"></i>
                }
                else if (Model.AlertType == "warning")
                {
                    <i class="bi bi-exclamation-triangle-fill fs-3 text-warning me-3"></i>
                }
                else if (Model.AlertType == "danger")
                {
                    <i class="bi bi-shield-x-fill fs-3 text-danger me-3"></i>
                }
                else
                {
                    <i class="bi bi-info-circle-fill fs-3 text-info me-3"></i>
                }
                <div>
                    <strong class="fs-5">@Model.AlertMessage</strong>
                </div>
            </div>
            @if (Model.BlockedStudentId.HasValue)
            {
                <form method="post" asp-page-handler="OverrideCheckIn" class="m-0">
                    <input type="hidden" name="studentId" value="@Model.BlockedStudentId.Value" />
                    <button type="submit" class="btn btn-warning text-dark fw-bold px-3 shadow-sm">
                        <i class="bi bi-unlock-fill me-1"></i> Liberar Entrada Mesmo Assim
                    </button>
                </form>
            }
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Linha 1: Operação e Acesso Imediato (Dois cards lado a lado perfeitamente alinhados) -->
<div class="row g-4 mb-4">
    <!-- Registrar Entrada de Atleta -->
    <div class="col-lg-6">
        <div class="boxing-card portaria-card p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="h4 text-white mb-0">
                        <i class="bi bi-shield-check text-secondary me-2"></i> Registrar Entrada de Atleta
                    </h3>
                    <span class="badge bg-secondary bg-opacity-50 text-light fw-semibold">Portaria / Catraca</span>
                </div>
                <p class="text-light opacity-75 small mb-3">
                    Identifique o atleta por matrícula (ex: <strong class="text-white">BX-1001</strong>), CPF ou nome. O sistema checa automaticamente se a matrícula está ativa e os pagamentos em dia.
                </p>

                <form method="post" asp-page-handler="RegisterEntry">
                    <div class="mb-3">
                        <label class="form-label text-white fw-bold">Matrícula, CPF ou Nome:</label>
                        <div class="input-group input-group-lg shadow-sm">
                            <span class="input-group-text portaria-icon">
                                <i class="bi bi-person-badge-fill"></i>
                            </span>
                            <input type="text" asp-for="SearchTerm" class="form-control portaria-input" placeholder="Digite matrícula (BX-1001), CPF ou nome..." autofocus required />
                        </div>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-danger btn-lg fw-bold text-white py-3 shadow">
                            <i class="bi bi-shield-check me-2"></i> Validar & Liberar Entrada
                        </button>
                    </div>
                </form>
            </div>

            <!-- Legenda Operacional Integrada -->
            <div class="pt-3 border-top border-secondary border-opacity-25">
                <div class="small text-secondary fw-bold text-uppercase mb-2">Critérios do Controle de Acesso:</div>
                <div class="d-flex flex-wrap gap-2 small">
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-2 py-1">
                        <i class="bi bi-check-circle me-1"></i> Liberado: Plano ativo e em dia
                    </span>
                    <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 px-2 py-1">
                        <i class="bi bi-exclamation-triangle me-1"></i> Alerta: Mensalidade pendente
                    </span>
                    <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 px-2 py-1">
                        <i class="bi bi-x-circle me-1"></i> Bloqueado: Inativo ou atrasado
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Atletas Treinando no Momento -->
    <div class="col-lg-6">
        <div class="boxing-card p-4 h-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="h4 text-white mb-0">
                    <i class="bi bi-people-fill text-secondary me-2"></i> Treinando no Momento (@Model.CurrentlyInGymList.Count)
                </h3>
                <span class="badge bg-warning bg-opacity-25 text-warning fw-bold px-3 py-1">Em Atividade</span>
            </div>

            @if (Model.CurrentlyInGymList.Any())
            {
                <div class="table-responsive flex-grow-1" style="max-height: 320px; overflow-y: auto;">
                    <table class="table table-dark-custom mb-0">
                        <thead>
                            <tr>
                                <th>Atleta</th>
                                <th>Plano & Nível</th>
                                <th>Horário</th>
                                <th class="text-end">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.CurrentlyInGymList)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-white">@log.Student?.FullName</div>
                                        <div class="small text-secondary">
                                            Matrícula: <span class="badge bg-secondary">@log.Student?.RegistrationCode</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-light">@log.Student?.Plan?.Name</div>
                                        <span class="badge bg-dark border border-secondary text-secondary small">@log.Student?.ExperienceLevel</span>
                                    </td>
                                    <td>
                                        <span class="text-warning fw-bold fs-6">@log.EntryTime.ToString("HH:mm")</span>
                                        <div class="small text-muted">@((int)(DateTime.Now - log.EntryTime).TotalMinutes) min atrás</div>
                                    </td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="RegisterExit" asp-route-logId="@log.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-info fw-semibold">
                                                <i class="bi bi-box-arrow-right me-1"></i> Dar Saída
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted flex-grow-1 d-flex flex-column justify-content-center">
                    <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                    Nenhum atleta treinando no momento na academia.
                </div>
            }
        </div>
    </div>
</div>

<!-- Linha 2: Histórico Completo do Dia -->
<div class="row g-4">
    <div class="col-12">
        <div class="boxing-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="h5 text-white mb-0">
                    <i class="bi bi-journal-text text-secondary me-2"></i> Todas as Entradas de Hoje (@Model.TodayLogs.Count)
                </h3>
                <span class="badge bg-dark border border-secondary text-light">Histórico Diário</span>
            </div>

            @if (Model.TodayLogs.Any())
            {
                <div class="table-responsive" style="max-height: 380px; overflow-y: auto;">
                    <table class="table table-dark-custom w-100 mb-0">
                        <thead>
                            <tr>
                                <th>Atleta</th>
                                <th>Matrícula</th>
                                <th>Entrada</th>
                                <th>Saída</th>
                                <th>Status de Acesso</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in Model.TodayLogs)
                            {
                                <tr>
                                    <td class="fw-bold text-white">@l.Student?.FullName</td>
                                    <td>
                                        <span class="badge bg-dark border border-secondary text-subtle-light">@l.Student?.RegistrationCode</span>
                                    </td>
                                    <td>
                                        <span class="text-white fw-semibold">@l.EntryTime.ToString("HH:mm")</span>
                                    </td>
                                    <td>
                                        @if (l.AccessStatus == AccessStatus.BloqueadoInativo || l.AccessStatus == AccessStatus.BloqueadoInadimplente)
                                        {
                                            <span class="badge bg-secondary text-light"><i class="bi bi-slash-circle me-1"></i> Entrada Barrada</span>
                                        }
                                        else if (l.ExitTime.HasValue)
                                        {
                                            <span class="text-subtle-light fw-semibold">@l.ExitTime.Value.ToString("HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-75"><i class="bi bi-broadcast"></i> No Treino</span>
                                        }
                                    </td>
                                    <td>
                                        @if (l.AccessStatus == AccessStatus.Autorizado)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Autorizado</span>
                                        }
                                        else if (l.AccessStatus == AccessStatus.BloqueadoInadimplente)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-octagon me-1"></i> Inadimplente</span>
                                        }
                                        else if (l.AccessStatus == AccessStatus.AlertaVencimento)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i> Pendência</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-octagon me-1"></i> Bloqueado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-secondary">
                    <i class="bi bi-inbox fs-2 d-block mb-2 text-muted"></i>
                    Nenhum registro de acesso registrado na data de hoje.
                </div>
            }
        </div>
    </div>
</div>
