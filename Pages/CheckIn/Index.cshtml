@page
@model BoxeGymManager.Pages.CheckIn.IndexModel
@{
    ViewData["Title"] = "Terminal de Entrada e Saída";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="display-6 text-white mb-0">CONTROLE DE ACESSO & CATRACA</h1>
        <p class="text-secondary mb-0">Registro de presença dos atletas e liberação de entrada no ringue.</p>
    </div>
    <div class="text-end">
        <span class="badge bg-dark border border-secondary text-warning fs-6 px-3 py-2">
            <i class="bi bi-clock me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </span>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.AlertMessage))
{
    <div class="alert alert-@Model.AlertType alert-dismissible fade show border-2 shadow-lg mb-4" role="alert">
        <div class="d-flex align-items-center">
            @if (Model.AlertType == "success")
            {
                <i class="bi bi-check-circle-fill fs-3 text-success me-3"></i>
            }
            else if (Model.AlertType == "warning")
            {
                <i class="bi bi-exclamation-triangle-fill fs-3 text-warning me-3"></i>
            }
            else if (Model.AlertType == "danger")
            {
                <i class="bi bi-shield-x-fill fs-3 text-danger me-3"></i>
            }
            else
            {
                <i class="bi bi-info-circle-fill fs-3 text-info me-3"></i>
            }
            <div>
                <strong class="fs-5">@Model.AlertMessage</strong>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Painel de Liberação de Entrada -->
    <div class="col-lg-5">
        <div class="boxing-card portaria-card p-4 mb-4">
            <h3 class="h4 text-white mb-3">
                <i class="bi bi-shield-check text-danger me-2"></i> Registrar Entrada de Atleta
            </h3>
            <p class="text-light opacity-75 small mb-3">
                Identifique o aluno por matrícula (ex: <strong class="text-white">BX-1001</strong>), CPF ou nome. O sistema checa automaticamente se a matrícula está ativa e os pagamentos em dia.
            </p>

            <form method="post" asp-page-handler="RegisterEntry">
                <div class="mb-3">
                    <label class="form-label text-white fw-bold">Matrícula, CPF ou Nome:</label>
                    <div class="input-group input-group-lg shadow-sm">
                        <span class="input-group-text portaria-icon">
                            <i class="bi bi-person-badge-fill"></i>
                        </span>
                        <input type="text" asp-for="SearchTerm" class="form-control portaria-input" placeholder="Digite matrícula (BX-1001), CPF ou nome..." autofocus required />
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-danger btn-lg fw-bold text-white py-3 shadow">
                        <i class="bi bi-shield-check me-2"></i> Validar & Liberar Entrada
                    </button>
                </div>
            </form>
        </div>

        <!-- Instruções Operacionais da Recepção -->
        <div class="boxing-card p-4">
            <h4 class="h6 text-uppercase text-secondary fw-bold mb-3">Legenda do Controle de Acesso</h4>
            <div class="d-flex flex-column gap-2 small">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Liberado</span>
                    <span class="text-secondary">Plano ativo e pagamento em dia.</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Alerta</span>
                    <span class="text-secondary">Mensalidade atrasada ou plano expirado (notificar na recepção).</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Bloqueado</span>
                    <span class="text-secondary">Aluno com cadastro inativo ou suspenso.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Lista de Atletas Presentes no Momento -->
    <div class="col-lg-7">
        <div class="boxing-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="h5 text-white mb-0">
                    <i class="bi bi-people-fill text-warning me-2"></i> Treinando no Momento (@Model.CurrentlyInGymList.Count)
                </h3>
                <span class="badge bg-warning bg-opacity-25 text-warning fw-bold px-3 py-1">Em Atividade</span>
            </div>

            @if (Model.CurrentlyInGymList.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark-custom">
                        <thead>
                            <tr>
                                <th>Atleta</th>
                                <th>Plano & Nível</th>
                                <th>Horário de Entrada</th>
                                <th class="text-end">Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.CurrentlyInGymList)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-white">@log.Student?.FullName</div>
                                        <div class="small text-secondary">
                                            Matrícula: <span class="badge bg-secondary">@log.Student?.RegistrationCode</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-light">@log.Student?.Plan?.Name</div>
                                        <span class="badge bg-dark border border-secondary text-secondary small">@log.Student?.ExperienceLevel</span>
                                    </td>
                                    <td>
                                        <span class="text-warning fw-bold fs-6">@log.EntryTime.ToString("HH:mm")</span>
                                        <div class="small text-muted">@((int)(DateTime.Now - log.EntryTime).TotalMinutes) min atrás</div>
                                    </td>
                                    <td class="text-end">
                                        <form method="post" asp-page-handler="RegisterExit" asp-route-logId="@log.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-info fw-semibold">
                                                <i class="bi bi-box-arrow-right me-1"></i> Dar Saída
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                    Nenhum atleta treinando no momento na academia.
                </div>
            }
        </div>

        <!-- Histórico do Dia -->
        <div class="boxing-card p-4">
            <h3 class="h5 text-white mb-3">
                <i class="bi bi-journal-text text-secondary me-2"></i> Todas as Entradas de Hoje (@Model.TodayLogs.Count)
            </h3>
            @if (Model.TodayLogs.Any())
            {
                <div class="table-responsive" style="max-height: 280px; overflow-y: auto;">
                    <table class="table table-dark-custom small mb-0">
                        <thead>
                            <tr>
                                <th>Atleta</th>
                                <th>Entrada</th>
                                <th>Saída</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in Model.TodayLogs)
                            {
                                <tr>
                                    <td>@l.Student?.FullName</td>
                                    <td>@l.EntryTime.ToString("HH:mm")</td>
                                    <td>@(l.ExitTime.HasValue ? l.ExitTime.Value.ToString("HH:mm") : "Presente")</td>
                                    <td>
                                        @if (l.AccessStatus == AccessStatus.Autorizado)
                                        {
                                            <span class="badge bg-success">Autorizado</span>
                                        }
                                        else if (l.AccessStatus == AccessStatus.AlertaVencimento)
                                        {
                                            <span class="badge bg-warning text-dark">Alerta Vencido</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Bloqueado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
