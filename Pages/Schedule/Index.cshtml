@page
@model BoxeGymManager.Pages.Schedule.IndexModel
@{
    ViewData["Title"] = "Grade de Horários & Aulas";

    string GetDayName(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => "Segunda-feira",
        DayOfWeek.Tuesday => "Terça-feira",
        DayOfWeek.Wednesday => "Quarta-feira",
        DayOfWeek.Thursday => "Quinta-feira",
        DayOfWeek.Friday => "Sexta-feira",
        DayOfWeek.Saturday => "Sábado",
        _ => "Domingo"
    };
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="display-6 text-white mb-0">GRADE DE HORÁRIOS & AULAS</h1>
        <p class="text-secondary mb-0">Cronograma semanal de treinos, instrutores e limites de vagas.</p>
    </div>
    <div>
        <a asp-page="/Schedule/Create" class="btn btn-danger fw-bold px-4 py-2">
            <i class="bi bi-plus-circle me-1"></i> Nova Turma / Horário
        </a>
    </div>
</div>

<div class="row g-4">
    @foreach (var kvp in Model.ClassesByDay)
    {
        var isToday = DateTime.Today.DayOfWeek == kvp.Key;
        <div class="col-lg-4 col-md-6">
            <div class="boxing-card p-3 h-100 @(isToday ? "border-danger border-2" : "")">
                <div class="d-flex justify-content-between align-items-center border-bottom border-secondary border-opacity-25 pb-2 mb-3">
                    <h3 class="h5 mb-0 text-white">
                        @GetDayName(kvp.Key)
                    </h3>
                    @if (isToday)
                    {
                        <span class="badge bg-danger text-uppercase fw-bold">Hoje</span>
                    }
                </div>

                @if (kvp.Value.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var c in kvp.Value)
                        {
                            var isFull = c.Students.Count >= c.MaxCapacity;
                            <div class="schedule-class-item p-2 px-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="fw-bold text-white">@c.DisplayName</span>
                                        <span class="text-secondary small ms-2">&bull; @c.CoachName</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="small fw-semibold @(isFull ? "text-danger" : "text-light")">
                                            @c.Students.Count/@c.MaxCapacity
                                        </span>
                                        <a asp-page="/Schedule/Edit" asp-route-id="@c.Id" class="text-secondary small hover-white" title="Editar aula">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(c.Description))
                                {
                                    <div class="text-secondary mt-1" style="font-size: 0.78rem;">
                                        @c.Description
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">
                        Sem aulas programadas para este dia.
                    </div>
                }
            </div>
        </div>
    }
</div>
